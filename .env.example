# ==============================================================================
# GAIA — Environment Configuration Example
# Copy to .env and configure your keys
# ==============================================================================

# AI Advisor Configuration (Supported Providers: google, ollama)
AI_PROVIDER=google
AI_MODEL=gemini-2.5-flash

# Google Gemini API Key
GEMINI_API_KEY=your_gemini_api_key_here

# Ollama API Configuration (for Ollama Cloud or self-hosted Ollama)
OLLAMA_API_KEY=your_ollama_api_key_here
OLLAMA_BASE_URL=https://api.ollama.com
OLLAMA_MODEL=llama3.3

# Optional: Google Geocoding API Key
GOOGLE_GEOCODING_API_KEY=

# USDA Agricultural Marketing Service MyMarketNews API Key
# Request free API key at: https://mymarketnews.ams.usda.gov/
# Used for Phoenix Shipping Point Vegetables Prices report (IX_FV120 / Report 2403)
USDA_MMN_API_KEY=

# USDA NASS QuickStats API Key
# Request free API key at: https://quickstats.nass.usda.gov/api
# Used for historical Arizona & Pima County crop yields, acreage, and production stats
USDA_NASS_API_KEY=

# Optional: PostgreSQL Database URL
DATABASE_URL=
